---
interface Props {
  label: string;
}

const { label } = Astro.props;

// One chip style across the whole site. Text tones are chosen for WCAG AA
// against the 10%-accent fill: 6.06:1 in light, 6.83:1 in dark.
---

<span
  class="inline-flex items-center rounded-md bg-accent-500/10 px-2 py-1 text-xs font-medium text-accent-700 ring-1 ring-accent-600/20 ring-inset dark:text-accent-400 dark:ring-accent-400/25"
  >{label}</span
>
