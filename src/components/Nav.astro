---
import ThemeToggle from "./ThemeToggle.astro";
import profile from "../data/profile.json";

// One entry per section on the page. Keep in sync with the Section ids in index.astro.
const links = [
  { href: "#focus", label: "Now" },
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#credentials", label: "Education" },
  { href: "#contact", label: "Contact" },
];

const initials = profile.name
  .split(" ")
  .map((part) => part[0])
  .join("");
---

<header
  class="no-print sticky top-0 z-40 border-b border-ink-100/80 bg-white/85 backdrop-blur-md dark:border-ink-900 dark:bg-ink-950/85"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-3xl items-center gap-3 px-5 py-3.5 sm:px-6"
  >
    <a
      href="#top"
      class="shrink-0 rounded font-mono text-sm font-semibold tracking-tight text-ink-900 transition-colors hover:text-accent-600 dark:text-ink-100 dark:hover:text-accent-400"
    >
      {initials}
    </a>

    {/*
      Seven items don't fit beside the logo and toggle below ~880px, so the list
      scrolls horizontally instead of collapsing. Every section stays reachable
      on a phone, which a hidden menu wouldn't manage.
    */}
    <ul
      class="scrollbar-none nav-fade -mx-1 flex flex-1 items-center gap-0.5 overflow-x-auto px-1 lg:justify-end lg:gap-1"
    >
      {
        links.map((link) => (
          <li class="shrink-0">
            <a
              href={link.href}
              class="block rounded-md px-2 py-1.5 text-[13px] whitespace-nowrap text-ink-600 transition-colors hover:bg-ink-50 hover:text-ink-900 lg:text-sm dark:text-ink-400 dark:hover:bg-ink-900 dark:hover:text-ink-100"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="shrink-0">
      <ThemeToggle />
    </div>
  </nav>
</header>
