---
import ThemeToggle from "./ThemeToggle.astro";
import profile from "../data/profile.json";

const links = [
  { href: "#focus", label: "Now" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];

const initials = profile.name
  .split(" ")
  .map((part) => part[0])
  .join("");
---

<header
  class="no-print sticky top-0 z-40 border-b border-ink-100/80 bg-white/85 backdrop-blur-md dark:border-ink-900 dark:bg-ink-950/85"
>
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-3xl items-center justify-between px-5 py-3.5 sm:px-6"
  >
    <a
      href="#top"
      class="rounded font-mono text-sm font-semibold tracking-tight text-ink-900 transition-colors hover:text-accent-600 dark:text-ink-100 dark:hover:text-accent-400"
    >
      {initials}
    </a>

    <div class="flex items-center gap-1.5">
      <ul class="mr-1 hidden items-center gap-1 sm:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-md px-2.5 py-1.5 text-sm text-ink-600 transition-colors hover:bg-ink-50 hover:text-ink-900 dark:text-ink-400 dark:hover:bg-ink-900 dark:hover:text-ink-100"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
