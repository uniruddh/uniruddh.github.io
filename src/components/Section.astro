---
interface Props {
  id: string;
  title: string;
  lead?: string;
  class?: string;
}

const { id, title, lead, class: className = "" } = Astro.props;
---

<section id={id} data-reveal class={`scroll-mt-24 py-14 sm:py-20 ${className}`}>
  <div class="mb-8 sm:mb-10">
    <h2
      class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-600 dark:text-accent-400"
    >
      {title}
    </h2>
    {
      lead && (
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-700 dark:text-ink-300">
          {lead}
        </p>
      )
    }
  </div>
  <slot />
</section>
