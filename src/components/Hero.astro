---
import profile from "../data/profile.json";
---

<section id="top" class="pt-14 pb-4 sm:pt-20">
  <p
    class="mb-5 inline-flex items-center gap-2 rounded-full border border-ink-200 px-3 py-1 text-xs font-medium text-ink-600 dark:border-ink-800 dark:text-ink-400"
  >
    <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
      <span
        class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-500 opacity-70"
      ></span>
      <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent-500"></span>
    </span>
    {profile.availability}
  </p>

  <h1
    class="text-4xl font-semibold tracking-tight text-ink-950 sm:text-5xl dark:text-white"
  >
    {profile.name}
  </h1>

  <p class="mt-3 text-lg font-medium text-ink-700 sm:text-xl dark:text-ink-300">
    {profile.title}<span class="text-ink-400 dark:text-ink-600">&nbsp;·&nbsp;</span><span
      class="text-accent-600 dark:text-accent-400">{profile.specialism}</span
    >
  </p>

  <p
    class="mt-6 max-w-2xl text-balance text-lg leading-relaxed text-ink-600 dark:text-ink-400"
  >
    {profile.tagline}
  </p>

  <div class="no-print mt-8 flex flex-wrap items-center gap-3">
    <a
      href={profile.resumeFile}
      download
      class="inline-flex items-center gap-2 rounded-md bg-ink-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-ink-800 dark:bg-white dark:text-ink-950 dark:hover:bg-ink-100"
    >
      <svg
        class="h-4 w-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path>
      </svg>
      Download CV
    </a>

    <a
      href={profile.links.github}
      rel="me noopener"
      class="inline-flex items-center gap-2 rounded-md border border-ink-200 px-4 py-2.5 text-sm font-medium text-ink-700 transition-colors hover:border-ink-300 hover:bg-ink-50 dark:border-ink-800 dark:text-ink-300 dark:hover:border-ink-700 dark:hover:bg-ink-900"
    >
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        ></path>
      </svg>
      GitHub
    </a>

    <a
      href={profile.links.linkedin}
      rel="me noopener"
      class="inline-flex items-center gap-2 rounded-md border border-ink-200 px-4 py-2.5 text-sm font-medium text-ink-700 transition-colors hover:border-ink-300 hover:bg-ink-50 dark:border-ink-800 dark:text-ink-300 dark:hover:border-ink-700 dark:hover:bg-ink-900"
    >
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path
          d="M13.63 13.63h-2.37V9.9c0-.89-.02-2.03-1.24-2.03-1.24 0-1.43.97-1.43 1.97v3.79H6.22V6h2.27v1.04h.03c.32-.6 1.09-1.23 2.24-1.23 2.4 0 2.84 1.58 2.84 3.63v4.19ZM3.55 4.96a1.38 1.38 0 1 1 0-2.75 1.38 1.38 0 0 1 0 2.75Zm1.19 8.67H2.36V6h2.38v7.63ZM14.82 0H1.18C.53 0 0 .52 0 1.16v13.68C0 15.48.53 16 1.18 16h13.64c.65 0 1.18-.52 1.18-1.16V1.16C16 .52 15.47 0 14.82 0Z"
        ></path>
      </svg>
      LinkedIn
    </a>
  </div>
</section>
