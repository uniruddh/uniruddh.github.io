---
import Chip from "./Chip.astro";

interface Props {
  title: string;
  body: string;
  tags: string[];
  index: number;
}

const { title, body, tags, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<article class="flex gap-4 sm:gap-5">
  <span
    class="mt-0.5 font-mono text-xs text-ink-300 tabular-nums dark:text-ink-700"
    aria-hidden="true">{number}</span
  >
  <div class="min-w-0">
    <h3 class="text-base font-semibold text-ink-950 dark:text-ink-50">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-400">{body}</p>
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.map((tag) => <Chip label={tag} accent />)}
    </div>
  </div>
</article>
