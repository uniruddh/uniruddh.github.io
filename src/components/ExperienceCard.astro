---
import Chip from "./Chip.astro";

interface Props {
  role: string;
  company: string;
  start: string;
  end: string;
  location: string;
  current: boolean;
  highlights: string[];
  stack: string[];
}

const { role, company, start, end, location, current, highlights, stack } = Astro.props;
---

<article
  class="relative border-l border-ink-200 pb-10 pl-6 last:pb-0 dark:border-ink-800"
>
  <span
    class={`absolute -left-[4.5px] top-1.5 h-2 w-2 rounded-full ring-4 ring-white dark:ring-ink-950 ${
      current ? "bg-accent-500" : "bg-ink-300 dark:bg-ink-700"
    }`}
    aria-hidden="true"></span>

  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-base font-semibold text-ink-950 dark:text-ink-50">
      {role}<span class="font-normal text-ink-400 dark:text-ink-600">&nbsp;·&nbsp;</span><span
        class="font-medium text-accent-600 dark:text-accent-400">{company}</span
      >
    </h3>
    <p class="font-mono text-xs whitespace-nowrap text-ink-500 dark:text-ink-400">
      {start} – {end}
    </p>
  </div>

  <p class="mt-0.5 text-xs text-ink-500 dark:text-ink-400">{location}</p>

  <ul class="mt-3 space-y-2">
    {
      highlights.map((point) => (
        <li class="flex gap-2.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
          <span
            class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink-300 dark:bg-ink-700"
            aria-hidden="true"
          />
          <span>{point}</span>
        </li>
      ))
    }
  </ul>

  {
    stack.length > 0 && (
      <div class="mt-3.5 flex flex-wrap gap-1.5">
        {stack.map((tech) => (
          <Chip label={tech} />
        ))}
      </div>
    )
  }
</article>
