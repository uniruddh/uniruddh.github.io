---
import profile from "../data/profile.json";
const year = new Date().getFullYear();
---

<footer
  class="mt-8 border-t border-ink-100 py-8 text-sm text-ink-500 dark:border-ink-900 dark:text-ink-400"
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p>© {year} {profile.name}</p>
    <p class="no-print">
      Built with <a
        href="https://astro.build"
        rel="noopener"
        class="text-ink-600 underline decoration-ink-300 underline-offset-2 transition-colors hover:text-accent-600 dark:text-ink-400 dark:decoration-ink-700 dark:hover:text-accent-400"
        >Astro</a
      > · hosted on GitHub Pages
    </p>
  </div>
</footer>
