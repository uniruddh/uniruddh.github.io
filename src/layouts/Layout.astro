---
import "@fontsource-variable/inter";
import "../styles/global.css";
import profile from "../data/profile.json";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · ${profile.title}, ${profile.specialism}`,
  description = `${profile.name} is a ${profile.title} specialising in ${profile.specialism.toLowerCase()}. ${profile.tagline}`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
const photo = new URL(profile.photo, Astro.site);

// Stable identifiers so the Person and WebSite nodes reference one another
// instead of Google having to infer that they describe the same entity.
const siteRoot = new URL("/", Astro.site).href;
const personId = `${siteRoot}#person`;
const websiteId = `${siteRoot}#website`;

const personSchema = {
  "@type": "Person",
  "@id": personId,
  name: profile.name,
  givenName: profile.givenName,
  familyName: profile.familyName,
  alternateName: profile.alternateName,
  jobTitle: profile.title,
  description: description,
  email: `mailto:${profile.email}`,
  url: canonical.href,
  image: photo.href,
  worksFor: {
    "@type": "Organization",
    name: "Particle41",
    url: "https://particle41.com",
  },
  address: {
    "@type": "PostalAddress",
    addressRegion: "Gujarat",
    addressCountry: "IN",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "L. D. College of Engineering, Gujarat Technological University",
    url: "https://ldce.ac.in/",
  },
  knowsAbout: [
    "Agentic AI engineering",
    "Multi-agent orchestration",
    "Enterprise application architecture",
    "Multi-tenant SaaS architecture",
    "Event-driven architecture",
    "NestJS",
    "Spring Boot",
    "AWS",
  ],
  sameAs: profile.sameAs,
};

// Declares the site name Google shows above the result, instead of letting it
// derive something from the github.io host. Home page only, per Google's spec.
const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  name: profile.name,
  alternateName: profile.alternateName,
  url: siteRoot,
  inLanguage: "en",
  publisher: { "@id": personId },
  about: { "@id": personId },
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [personSchema, websiteSchema],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="google-site-verification" content="dACIIqBrUK4KyQ0kx5KCdLEa9rznDJPCitDEwuo_7ZQ" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {profile.sameAs.map((href) => <link rel="me" href={href} />)}
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#111417" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.title}`} />
    <meta property="og:site_name" content={profile.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={profile.twitterHandle} />
    <meta name="twitter:creator" content={profile.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={`${profile.name} — ${profile.title}`} />

    <script is:inline set:html={JSON.stringify(schema)} type="application/ld+json" />

    {/* Set the theme before first paint to avoid a flash of the wrong colours. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (stored === "dark" || (!stored && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {
          /* localStorage unavailable; fall back to the light default. */
        }
      })();
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="no-print sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent-600 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      Skip to content
    </a>

    <slot />

    {/* Reveal-on-scroll. Progressive enhancement: without JS everything is visible. */}
    <script is:inline>
      (function () {
        if (!("IntersectionObserver" in window)) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        var targets = document.querySelectorAll("[data-reveal]");
        targets.forEach(function (el) {
          el.classList.add("js-reveal");
        });

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
        );

        targets.forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
